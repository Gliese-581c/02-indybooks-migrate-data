@model IndyBooks.ViewModels.CreateBookVM
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewBag.Title = "Create Book";

}
<h3>Add New Book</h3>
<form asp-action="CreateBook" asp-controller="Admin">
    <!-- TODO: Modify the basic template below using asp- tag helpers to create 
        a label, field, and validaiton error message span for each CreateBook field in Fig.3 -->
    <div>
        <label asp-for="Title" ></label>
        <input asp-for="Title"/>
        <span asp-validation-for="Title" ></span>
    </div>
    <div>
        <label asp-for="Author" ></label>
        <input asp-for="Author"/>
        <span asp-validation-for="Author" ></span>
    </div>
    <div>
        <label asp-for="SKU" ></label>
        <input asp-for="SKU"/>
        <span asp-validation-for="SKU" ></span>
    </div>
    <div>
        <label asp-for="Price" ></label>
        <input asp-for="Price"/>
        <span asp-validation-for="Price" ></span>
    </div>
    <div>
        <label asp-for="Year" ></label>
        <input asp-for="Year"/>
        <span asp-validation-for="Year" ></span>
    </div>
   
    <input type="submit" value="Submit" />
</form>
